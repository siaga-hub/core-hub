# Copy to .env (never commit .env). Values below are LOCAL DEV ONLY.

# --- Environment ---
APP_ENV=local                      # local | staging | production
LOG_LEVEL=INFO

# --- Database (Supabase local defaults; Alembic uses MIGRATOR, API uses APP) ---
DATABASE_URL_MIGRATOR=postgresql+psycopg://siaga_migrator:siaga_migrator_dev@127.0.0.1:54322/postgres
DATABASE_URL_APP=postgresql+asyncpg://siaga_app:siaga_app_dev@127.0.0.1:54322/postgres
SIAGA_MIGRATOR_PASSWORD=siaga_migrator_dev
SIAGA_APP_PASSWORD=siaga_app_dev
SIAGA_READONLY_PASSWORD=siaga_readonly_dev

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- Supabase ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=                 # printed by `supabase status`
SUPABASE_SERVICE_ROLE_KEY=         # printed by `supabase status`; server-side only
SUPABASE_JWT_SECRET=               # only if local JWT signing is HS256
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_SEND_SMS_HOOK_SECRET=     # v1,whsec_... shared with GoTrue hook config

# --- API ---
API_CORS_ORIGINS=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000

# --- Seed / dev identities (local only) ---
SEED_STAFF_EMAIL=staff@siaga.local
SEED_STAFF_PASSWORD=change-me-local-only
SEED_DRIVER_PHONE=+94770000001
SEED_DRIVER_TEST_OTP=123456

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Driver app (Expo): use your PC's LAN IP so the phone can reach it ---
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.10:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Integrations (empty = disabled / dev stub) ---
SMS_PROVIDER=dev_log               # dev_log | <local gateway later>
GOOGLE_MAPS_API_KEY=
SENTRY_DSN=
